/* =========================================================
   3. Three.js 3D 立體匾額引擎
   ========================================================= */
let scene, camera, renderer, plaqueGroup, frontMesh, frameMeshes = [], ballsGroup;
let targetRotX = 0.05, targetRotY = -0.12;
let currentRotX = 0.05, currentRotY = -0.12;
let targetPosX = 0, targetPosY = 0;
let isDragging = false, prevX = 0, prevY = 0;
let videoStream = null;

function initThree() {
  const container = document.getElementById('stage-container');
  const canvas = document.getElementById('three-canvas');

  scene = new THREE.Scene();

  camera = new THREE.PerspectiveCamera(40, container.clientWidth / container.clientHeight, 0.1, 100);
  camera.position.set(0, 0, 6.2);

  renderer = new THREE.WebGLRenderer({
    canvas: canvas,
    antialias: true,
    alpha: true,
    preserveDrawingBuffer: true
  });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.outputEncoding = THREE.sRGBEncoding;

  // 立體燈光
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.72);
  scene.add(ambientLight);

  const keyLight = new THREE.DirectionalLight(0xfff5e0, 1.15);
  keyLight.position.set(4, 6, 8);
  scene.add(keyLight);

  const rimLight = new THREE.DirectionalLight(0xffd28a, 0.6);
  rimLight.position.set(-5, -3, 5);
  scene.add(rimLight);

  buildPlaque3D();
  setupTouchControls(canvas);
  window.addEventListener('resize', onResize);

  document.fonts.ready.then(() => {
    updatePlaqueTexture();
  });

  animate();
}

function buildPlaque3D() {
  plaqueGroup = new THREE.Group();
  scene.add(plaqueGroup);

  const W = 4.6, H = 1.75, D = 0.18;

  const bodyGeo = new THREE.BoxGeometry(W, H, D);
  const sideMat = new THREE.MeshStandardMaterial({ color: 0x3b1f14, roughness: 0.65, metalness: 0.15 });
  const frontMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.35, metalness: 0.25, bumpScale: 0.035 });

  const materials = [sideMat, sideMat, sideMat, sideMat, frontMat, sideMat];
  frontMesh = new THREE.Mesh(bodyGeo, materials);
  plaqueGroup.add(frontMesh);

  // 立體凸起外框
  const frameMat = new THREE.MeshStandardMaterial({ color: 0x6b2016, roughness: 0.4, metalness: 0.35 });
  const barT = 0.14;
  const barD = 0.24;

  const topBar = new THREE.Mesh(new THREE.BoxGeometry(W + barT * 2, barT, barD), frameMat);
  topBar.position.set(0, H / 2 + barT / 2 - 0.02, 0.02);

  const botBar = new THREE.Mesh(new THREE.BoxGeometry(W + barT * 2, barT, barD), frameMat);
  botBar.position.set(0, -H / 2 - barT / 2 + 0.02, 0.02);

  const leftBar = new THREE.Mesh(new THREE.BoxGeometry(barT, H, barD), frameMat);
  leftBar.position.set(-W / 2 - barT / 2 + 0.02, 0, 0.02);

  const rightBar = new THREE.Mesh(new THREE.BoxGeometry(barT, H, barD), frameMat);
  rightBar.position.set(W / 2 + barT / 2 - 0.02, 0, 0.02);

  frameMeshes = [topBar, botBar, leftBar, rightBar];
  frameMeshes.forEach(m => plaqueGroup.add(m));

  // 立體三朵大紅彩球 + 兩側紅布帶
  ballsGroup = new THREE.Group();
  const ballMat = new THREE.MeshStandardMaterial({ color: 0xd91e18, roughness: 0.65, metalness: 0.05 });
  const ballPositions = [-W / 2 - 0.02, 0, W / 2 + 0.02];

  ballPositions.forEach(bx => {
    const flower = new THREE.Group();
    const core = new THREE.Mesh(new THREE.DodecahedronGeometry(0.22, 1), ballMat);
    flower.add(core);
    for (let i = 0; i < 8; i++) {
      const angle = (i / 8) * Math.PI * 2;
      const petal = new THREE.Mesh(new THREE.IcosahedronGeometry(0.11, 0), ballMat);
      petal.position.set(Math.cos(angle) * 0.14, Math.sin(angle) * 0.14, 0.09);
      flower.add(petal);
    }
    flower.position.set(bx, H / 2 + 0.08, 0.16);
    ballsGroup.add(flower);
  });

  const ribbonMat = new THREE.MeshStandardMaterial({ color: 0xc81912, roughness: 0.7 });
  const topRibbon = new THREE.Mesh(new THREE.BoxGeometry(W + 0.16, 0.07, 0.05), ribbonMat);
  topRibbon.position.set(0, H / 2 + 0.11, 0.12);
  ballsGroup.add(topRibbon);

  [-W / 2 - 0.09, W / 2 + 0.09].forEach(rx => {
    const sideRibbon = new THREE.Mesh(new THREE.BoxGeometry(0.06, H + 0.16, 0.05), ribbonMat);
    sideRibbon.position.set(rx, 0, 0.11);
    ballsGroup.add(sideRibbon);
  });

  plaqueGroup.add(ballsGroup);
}

/* 動態繪製匾額正面貼圖 + 浮雕凹凸貼圖 */
function updatePlaqueTexture() {
  const cw = 1536, ch = 584;
  const colorCanvas = document.createElement('canvas');
  colorCanvas.width = cw; colorCanvas.height = ch;
  const ctx = colorCanvas.getContext('2d');

  const bumpCanvas = document.createElement('canvas');
  bumpCanvas.width = cw; bumpCanvas.height = ch;
  const bctx = bumpCanvas.getContext('2d');
  bctx.fillStyle = '#404040';
  bctx.fillRect(0, 0, cw, ch);

  const st = state.style;

  if (st === 'imperial') {
    const grad = ctx.createLinearGradient(0, 0, cw, ch);
    grad.addColorStop(0, '#f5c731');
    grad.addColorStop(0.5, '#ffda47');
    grad.addColorStop(1, '#e8b522');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, cw, ch);
    setFrameColor(0x6b2419, 0.45, 0.2);
  } else if (st === 'blackgold') {
    const grad = ctx.createLinearGradient(0, 0, 0, ch);
    grad.addColorStop(0, '#1c1c1c');
    grad.addColorStop(0.5, '#0d0d0d');
    grad.addColorStop(1, '#1a1a1a');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, cw, ch);
    setFrameColor(0x1e1a16, 0.35, 0.5);
  } else if (st === 'wood') {
    const grad = ctx.createLinearGradient(0, 0, 0, ch);
    grad.addColorStop(0, '#e3be82');
    grad.addColorStop(0.5, '#d4a662');
    grad.addColorStop(1, '#dfb574');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, cw, ch);
    ctx.strokeStyle = 'rgba(130, 78, 28, 0.16)';
    for (let y = 0; y < ch; y += 7) {
      ctx.beginPath();
      ctx.lineWidth = 1 + Math.random() * 2.5;
      ctx.moveTo(0, y);
      for (let x = 0; x <= cw; x += 120) {
        ctx.lineTo(x, y + Math.sin(x * 0.008 + y * 0.05) * 4);
      }
      ctx.stroke();
    }
    setFrameColor(0x9e6c38, 0.55, 0.1);
  } else if (st === 'blue') {
    const grad = ctx.createRadialGradient(cw/2, ch/2, 80, cw/2, ch/2, cw*0.6);
    grad.addColorStop(0, '#2e65d1');
    grad.addColorStop(1, '#183b8a');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, cw, ch);
    for (let i = 0; i < 450; i++) {
      ctx.fillStyle = `rgba(255,255,255,${Math.random() * 0.05})`;
      ctx.beginPath();
      ctx.arc(Math.random() * cw, Math.random() * ch, Math.random() * 26, 0, Math.PI * 2);
      ctx.fill();
    }
    setFrameColor(0x7c4e18, 0.35, 0.65);
  }

  drawInnerBorder(ctx, bctx, cw, ch, st);

  const rawMain = (state.mainText || '平安健康').trim();
  const chars = Array.from(rawMain);
  const displayChars = state.rtl ? [...chars].reverse() : chars;
  const count = Math.max(displayChars.length, 1);

  const fontSize = count <= 3 ? 250 : count === 4 ? 225 : 175;
  const fontFamily = '"Ma Shan Zheng", "Noto Serif TC", "DFKai-SB", "BiauKai", serif';

  const usableW = cw - 380;
  const stepX = usableW / count;
  const startX = 190 + stepX / 2;
  const centerY = ch / 2 + 22;

  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.font = `900 ${fontSize}px ${fontFamily}`;

  bctx.textAlign = 'center';
  bctx.textBaseline = 'middle';
  bctx.font = `900 ${fontSize}px ${fontFamily}`;

  displayChars.forEach((chStr, idx) => {
    const cx = startX + idx * stepX;

    bctx.fillStyle = '#ffffff';
    bctx.fillText(chStr, cx, centerY);

    ctx.save();
    ctx.shadowColor = 'rgba(0,0,0,0.42)';
    ctx.shadowBlur = 12;
    ctx.shadowOffsetX = 6;
    ctx.shadowOffsetY = 8;

    if (st === 'blackgold' || st === 'blue') {
      const goldGrad = ctx.createLinearGradient(cx, centerY - fontSize/2, cx, centerY + fontSize/2);
      goldGrad.addColorStop(0, '#fff3b0');
      goldGrad.addColorStop(0.45, '#f2c94c');
      goldGrad.addColorStop(1, '#c59018');
      ctx.fillStyle = goldGrad;
    } else {
      ctx.fillStyle = '#181412';
    }
    ctx.fillText(chStr, cx, centerY);
    ctx.restore();
  });

  const subColor = (st === 'blackgold' || st === 'blue') ? '#f2cf66' : '#261d17';
  drawVerticalText(ctx, state.upperText, cw - 110, 105, 36, subColor);
  drawVerticalText(ctx, state.lowerText, 110, ch - 115 - Math.min(state.lowerText.length, 8) * 34, 34, subColor);

  if (st === 'imperial' || st === 'blue') {
    drawSeal(ctx, cw / 2, 74, 52, '御賜');
  } else {
    drawSeal(ctx, 110, ch - 82, 42, '印');
  }

  const colorTex = new THREE.CanvasTexture(colorCanvas);
  colorTex.encoding = THREE.sRGBEncoding;
  colorTex.anisotropy = 8;

  const bumpTex = new THREE.CanvasTexture(bumpCanvas);

  const frontMat = frontMesh.material[4];
  if (frontMat.map) frontMat.map.dispose();
  if (frontMat.bumpMap) frontMat.bumpMap.dispose();

  frontMat.map = colorTex;
  frontMat.bumpMap = bumpTex;
  frontMat.metalness = (st === 'blackgold' || st === 'blue') ? 0.42 : 0.12;
  frontMat.roughness = (st === 'wood') ? 0.55 : 0.32;
  frontMat.needsUpdate = true;
}

function setFrameColor(hex, roughness, metalness) {
  frameMeshes.forEach(m => {
    m.material.color.setHex(hex);
    m.material.roughness = roughness;
    m.material.metalness = metalness;
  });
}

function drawInnerBorder(ctx, bctx, cw, ch, st) {
  if (st === 'blackgold') {
    ctx.strokeStyle = '#e5be53';
    ctx.lineWidth = 10;
    ctx.strokeRect(24, 24, cw - 48, ch - 48);
    ctx.lineWidth = 4;
    ctx.setLineDash([28, 12]);
    ctx.strokeRect(42, 42, cw - 84, ch - 84);
    ctx.setLineDash([]);

    bctx.strokeStyle = '#dddddd';
    bctx.lineWidth = 10;
    bctx.strokeRect(24, 24, cw - 48, ch - 48);
  } else if (st === 'imperial') {
    ctx.strokeStyle = '#9e2618';
    ctx.lineWidth = 14;
    ctx.strokeRect(18, 18, cw - 36, ch - 36);
    ctx.strokeStyle = '#d4af37';
    ctx.lineWidth = 4;
    ctx.strokeRect(32, 32, cw - 64, ch - 64);
  } else if (st === 'blue') {
    ctx.strokeStyle = '#c89b3c';
    ctx.lineWidth = 18;
    ctx.strokeRect(16, 16, cw - 32, ch - 32);
    ctx.strokeStyle = '#f5d97a';
    ctx.lineWidth = 4;
    ctx.strokeRect(34, 34, cw - 68, ch - 68);
    bctx.strokeStyle = '#ffffff';
    bctx.lineWidth = 18;
    bctx.strokeRect(16, 16, cw - 32, ch - 32);
  } else if (st === 'wood') {
    ctx.strokeStyle = 'rgba(120, 68, 22, 0.35)';
    ctx.lineWidth = 6;
    ctx.strokeRect(18, 18, cw - 36, ch - 36);
  }
}

function drawVerticalText(ctx, text, x, startY, size, color) {
  if (!text) return;
  ctx.save();
  ctx.fillStyle = color;
  ctx.font = `700 ${size}px "Noto Serif TC", "DFKai-SB", serif`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  const chars = Array.from(text.trim());
  chars.forEach((c, i) => {
    ctx.fillText(c, x, startY + i * (size + 8));
  });
  ctx.restore();
}

function drawSeal(ctx, cx, cy, size, label) {
  ctx.save();
  ctx.fillStyle = '#b81d13';
  ctx.fillRect(cx - size / 2, cy - size / 2, size, size);
  ctx.strokeStyle = '#ffdfd9';
  ctx.lineWidth = 2.5;
  ctx.strokeRect(cx - size / 2 + 4, cy - size / 2 + 4, size - 8, size - 8);
  ctx.fillStyle = '#fff3ee';
  ctx.font = `900 ${Math.floor(size * 0.42)}px "Noto Serif TC", serif`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(label.slice(0, 2), cx, cy + 1);
  ctx.restore();
}

function toggleAccessories() {
  state.showBalls = document.getElementById('chk-balls').checked;
  state.rtl = document.getElementById('chk-rtl').checked;
  if (ballsGroup) ballsGroup.visible = state.showBalls;
}

/* =========================================================
   4. 手勢觸控 & 陀螺儀互動
   ========================================================= */
function setupTouchControls(canvas) {
  const onDown = (x, y) => { isDragging = true; prevX = x; prevY = y; };
  const onMove = (x, y) => {
    if (!isDragging) return;
    const dx = x - prevX;
    const dy = y - prevY;
    prevX = x; prevY = y;

    if (state.isAR) {
      targetPosX = Math.max(-2.2, Math.min(2.2, targetPosX + dx * 0.008));
      targetPosY = Math.max(-2.5, Math.min(2.5, targetPosY - dy * 0.008));
    } else {
      targetRotY = Math.max(-0.85, Math.min(0.85, targetRotY + dx * 0.008));
      targetRotX = Math.max(-0.55, Math.min(0.55, targetRotX + dy * 0.008));
    }
  };
  const onUp = () => { isDragging = false; };

  canvas.addEventListener('mousedown', e => onDown(e.clientX, e.clientY));
  window.addEventListener('mousemove', e => onMove(e.clientX, e.clientY));
  window.addEventListener('mouseup', onUp);

  canvas.addEventListener('touchstart', e => {
    if (e.touches.length === 1) onDown(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: true });
  canvas.addEventListener('touchmove', e => {
    if (e.touches.length === 1) onMove(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: true });
  canvas.addEventListener('touchend', onUp);

  window.addEventListener('deviceorientation', (e) => {
    if (!state.isAR || !state.gyroEnabled || e.beta === null) return;
    const tiltX = ((e.beta - 75) / 60) * 0.35;
    const tiltY = ((e.gamma || 0) / 60) * 0.4;
    targetRotX = Math.max(-0.45, Math.min(0.45, tiltX));
    targetRotY = Math.max(-0.55, Math.min(0.55, tiltY));
  });
}

function animate() {
  requestAnimationFrame(animate);
  if (!plaqueGroup) return;

  currentRotX += (targetRotX - currentRotX) * 0.1;
  currentRotY += (targetRotY - currentRotY) * 0.1;

  plaqueGroup.rotation.x = currentRotX;
  plaqueGroup.rotation.y = currentRotY;

  const floatY = Math.sin(Date.now() * 0.0018) * 0.03;
  plaqueGroup.position.x += (targetPosX - plaqueGroup.position.x) * 0.12;
  plaqueGroup.position.y += ((targetPosY + floatY) - plaqueGroup.position.y) * 0.12;

  const s = state.isAR ? state.arScale : 0.92;
  plaqueGroup.scale.set(s, s, s);

  renderer.render(scene, camera);
}

function onResize() {
  const container = document.getElementById('stage-container');
  camera.aspect = container.clientWidth / container.clientHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(container.clientWidth, container.clientHeight);
}

/* =========================================================
   5. AR 實景相機模式（iOS Safari 完整修正版）& 拍照留念
   ========================================================= */
function showARError(msg) {
  const banner = document.getElementById('ar-error-banner');
  const textEl = document.getElementById('ar-error-text');
  textEl.innerHTML = msg;
  banner.style.display = 'block';
}

function hideARError() {
  document.getElementById('ar-error-banner').style.display = 'none';
}

async function enterARMode(tryCamera) {
  state.isAR = true;
  targetPosX = 0; targetPosY = 0.15;
  targetRotX = 0; targetRotY = 0;

  const stage = document.getElementById('stage-container');
  stage.classList.add('ar-fullscreen');
  document.getElementById('stage-hint').textContent = '📱 舉起手機對準牆面・手指可拖曳位置';

  setTimeout(onResize, 380);

  // 直接在使用者點擊手勢中啟動相機，不被陀螺儀權限打斷
  if (tryCamera) {
    await startARCamera();
  } else {
    showSimWall(false);
  }
}

async function startARCamera() {
  const video = document.getElementById('ar-video');
  const simWall = document.getElementById('sim-wall');
  const btnBg = document.getElementById('btn-toggle-bg');
  const btnFlip = document.getElementById('btn-flip-cam');

  hideARError();

  // 1. 檢查是否為安全環境（HTTPS 或 localhost）
  if (!window.isSecureContext) {
    showARError(
      '<strong>⚠️ 無法啟動相機：目前不是 HTTPS 網址</strong><br>' +
      '目前協定為 <code>' + location.protocol + '</code>。iPhone 規定必須透過 <strong>https://</strong> 網址並用 <strong>Safari</strong> 開啟（不能直接點開本機檔案）。'
    );
    showSimWall(true);
    return;
  }

  // 2. 檢查瀏覽器是否支援相機 API
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    showARError(
      '<strong>⚠️ 此瀏覽器不支援相機</strong><br>' +
      '如果你是從 LINE / Facebook / IG 點開連結，請改用右上角或右下角選擇「<strong>以 Safari 開啟</strong>」。'
    );
    showSimWall(true);
    return;
  }

  // 3. 開新鏡頭前務必先釋放舊鏡頭（iPhone 關鍵修正）
  stopARCamera();

  try {
    let stream;
    try {
      // 優先開啟指定鏡頭（預設後鏡頭）
      stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: { ideal: state.facingMode },
          width: { ideal: 1280 },
          height: { ideal: 720 }
        },
        audio: false
      });
    } catch (e1) {
      // 降級嘗試 1：不指定解析度
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: state.facingMode },
          audio: false
        });
      } catch (e2) {
        // 降級嘗試 2：最基本相機要求
        stream = await navigator.mediaDevices.getUserMedia({
          video: true,
          audio: false
        });
      }
    }

    videoStream = stream;

    // 4. 確保 iOS Safari 內嵌播放與明確呼叫 play()
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    video.muted = true;
    video.playsInline = true;
    video.srcObject = stream;

    video.style.display = 'block';
    simWall.style.display = 'none';

    await video.play();

    state.useCamera = true;
    btnBg.textContent = '🏫 換模擬牆';
    btnFlip.style.display = 'flex';
    showToast('📷 AR 相機已開啟！對準牆面拖曳匾額吧');
  } catch (err) {
    let reason = '';
    if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
      reason = '<strong>⚠️ 相機權限被拒絕</strong><br>請點 Safari 網址列左側「大小 / 設定」→ 網站設定 → 相機改為「<strong>允許</strong>」，再點下方重試。';
    } else if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
      reason = '<strong>⚠️ 找不到相機鏡頭</strong><br>請確認裝置是否有可用的攝影機。';
    } else if (err.name === 'NotReadableError' || err.name === 'TrackStartError') {
      reason = '<strong>⚠️ 相機正被其他程式佔用</strong><br>請先關閉其他正在使用相機的 App 後重試。';
    } else {
      reason = `<strong>⚠️ 無法開啟相機</strong><br>${err.name}: ${err.message}`;
    }
    showARError(reason);
    showSimWall(true);
  }
}

function flipCamera() {
  state.facingMode = state.facingMode === 'environment' ? 'user' : 'environment';
  startARCamera();
}

function showSimWall(keepError) {
  stopARCamera();
  if (!keepError) hideARError();
  document.getElementById('ar-video').style.display = 'none';
  document.getElementById('sim-wall').style.display = 'block';
  document.getElementById('btn-toggle-bg').textContent = '📷 開啟相機';
  document.getElementById('btn-flip-cam').style.display = 'none';
  state.useCamera = false;
}

function toggleARBackground() {
  if (state.useCamera) {
    showSimWall(false);
  } else {
    startARCamera();
  }
}

function stopARCamera() {
  if (videoStream) {
    videoStream.getTracks().forEach(t => t.stop());
    videoStream = null;
  }
  const video = document.getElementById('ar-video');
  if (video) video.srcObject = null;
}

function exitARMode() {
  state.isAR = false;
  stopARCamera();
  hideARError();
  document.getElementById('ar-video').style.display = 'none';
  document.getElementById('sim-wall').style.display = 'none';
  document.getElementById('btn-flip-cam').style.display = 'none';
  document.getElementById('stage-container').classList.remove('ar-fullscreen');
  document.getElementById('stage-hint').textContent = '👆 手指滑動可旋轉立體匾額';
  targetPosX = 0; targetPosY = 0;
  targetRotX = 0.05; targetRotY = -0.12;
  setTimeout(onResize, 380);
}

function updateARScale(val) {
  state.arScale = parseFloat(val);
}

async function toggleGyro() {
  if (!state.gyroEnabled) {
    // iOS 13+ 需由使用者主動點擊請求陀螺儀權限
    if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
      try {
        const res = await DeviceOrientationEvent.requestPermission();
        if (res !== 'granted') {
          showToast('未允許動作感應權限，仍可用手指滑動調整');
          return;
        }
      } catch (e) {
        showToast('此裝置不支援動作感應');
        return;
      }
    }
    state.gyroEnabled = true;
    showToast('🧭 已開啟舉起感應');
  } else {
    state.gyroEnabled = false;
    targetRotX = 0; targetRotY = 0;
  }
  document.getElementById('btn-gyro').textContent = state.gyroEnabled ? '🧭 舉起感應：開' : '🧭 舉起感應：關';
}

/* 揭匾紅布儀式 */
function triggerCeremony() {
  const cloth = document.getElementById('red-cloth');
  cloth.classList.add('covered');
}

function uncoverPlaque() {
  const cloth = document.getElementById('red-cloth');
  cloth.classList.remove('covered');
  showToast('🎊 揭匾成功！掌聲鼓勵！');
}

/* 合成背景與 3D 匾額拍照下載 */
function capturePhoto() {
  const threeCanvas = document.getElementById('three-canvas');
  const video = document.getElementById('ar-video');
  const out = document.createElement('canvas');
  out.width = threeCanvas.width;
  out.height = threeCanvas.height;
  const ctx = out.getContext('2d');

  if (state.isAR && state.useCamera && video.readyState >= 2) {
    const vw = video.videoWidth, vh = video.videoHeight;
    const cw = out.width, ch = out.height;
    const scale = Math.max(cw / vw, ch / vh);
    const dw = vw * scale, dh = vh * scale;
    ctx.drawImage(video, (cw - dw) / 2, (ch - dh) / 2, dw, dh);
  } else if (state.isAR) {
    ctx.fillStyle = '#efe4d2';
    ctx.fillRect(0, 0, out.width, out.height);
  } else {
    ctx.fillStyle = '#2d211c';
    ctx.fillRect(0, 0, out.width, out.height);
  }

  renderer.render(scene, camera);
  ctx.drawImage(threeCanvas, 0, 0);

  const link = document.createElement('a');
  link.download = `我的立體匾額_${state.mainText}.png`;
  link.href = out.toDataURL('image/png');
  link.click();
  showToast('📸 匾額照片已下載！');
}

/* =========================================================
   6. 互動介面邏輯（步驟切換、靈感詞庫）
   ========================================================= */
function renderRecipients() {
  const grid = document.getElementById('recipient-grid');
  grid.innerHTML = RECIPIENTS.map(r => `
    <div class="recipient-card ${r.id === state.recipient ? 'selected' : ''}" onclick="selectRecipient('${r.id}')">
      <span class="emoji">${r.emoji}</span>
      <span class="label">${r.label}</span>
    </div>
  `).join('');
}

function selectRecipient(id) {
  state.recipient = id;
  const found = RECIPIENTS.find(r => r.id === id);
  if (found) {
    state.upperText = found.upper;
    state.mainText = found.defaultWord;
    document.getElementById('input-upper').value = state.upperText;
    document.getElementById('input-main').value = state.mainText;
  }
  renderRecipients();
  renderPhrases();
  updatePlaqueTexture();
}

function switchIdeaCat(cat) {
  state.ideaCat = cat;
  document.querySelectorAll('.idea-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + cat).classList.add('active');
  renderPhrases();
}

function renderPhrases() {
  const list = state.ideaCat === 'praise'
    ? (PHRASES.praise[state.recipient] || PHRASES.praise.mom)
    : PHRASES[state.ideaCat];

  const grid = document.getElementById('phrase-grid');
  grid.innerHTML = list.map(item => `
    <button class="phrase-btn ${state.mainText === item.w ? 'selected' : ''}" onclick="pickPhrase('${item.w}')">
      <span class="word">${item.w}</span>
      <span class="meaning">${item.m}</span>
    </button>
  `).join('');
}

function pickPhrase(word) {
  state.mainText = word;
  document.getElementById('input-main').value = word;
  renderPhrases();
  updatePlaqueTexture();
}

function randomPhrase() {
  const pool = [
    ...(PHRASES.praise[state.recipient] || []),
    ...PHRASES.bless,
    ...PHRASES.classic
  ];
  const pick = pool[Math.floor(Math.random() * pool.length)];
  pickPhrase(pick.w);
  showToast(`💡 靈感：${pick.w}（${pick.m}）`);
}

function syncTextFromInputs() {
  state.mainText = document.getElementById('input-main').value || '平安健康';
  state.upperText = document.getElementById('input-upper').value;
  state.lowerText = document.getElementById('input-lower').value;
  updatePlaqueTexture();
}

function selectStyle(styleKey) {
  state.style = styleKey;
  document.querySelectorAll('.style-card').forEach(c => {
    c.classList.toggle('selected', c.dataset.style === styleKey);
  });
  const defaultBalls = (styleKey === 'blackgold' || styleKey === 'wood');
  document.getElementById('chk-balls').checked = defaultBalls;
  toggleAccessories();
  updatePlaqueTexture();
}

function goStep(stepNum) {
  document.querySelectorAll('.step-tab').forEach(t => {
    t.classList.toggle('active', Number(t.dataset.step) === stepNum);
  });
  document.querySelectorAll('.step-section').forEach(s => s.classList.remove('active'));
  document.getElementById('step-' + stepNum).classList.add('active');
  document.querySelector('.panel-body').scrollTop = 0;
}

function showToast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(() => el.classList.remove('show'), 2200);
}

/* 初始化 */
window.addEventListener('DOMContentLoaded', () => {
  renderRecipients();
  renderPhrases();
  initThree();
  document.getElementById('chk-balls').checked = false;
  toggleAccessories();
});
</script>
